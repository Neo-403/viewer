<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CA1014</NoWarn>
  </PropertyGroup>

  <!-- Versioning. The real version comes from the nearest git release tag (see
       Directory.Build.targets → SetVersionFromGit). This is only the fallback
       for builds without git / tags, so a tarball build never shows 1.0.0.0. -->
  <PropertyGroup>
    <Version>0.1.9</Version>
    <!-- We set a clean InformationalVersion ourselves; suppress the SDK's
         "+<commit-sha>" suffix so About shows just the tag. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Where the app looks for new versions (Infrastructure/Updates/UpdateFeedFactory):
       github:<owner>/<repo>, an https:// URL of a latest.json manifest, or none to turn
       update checks off (store builds such as F-Droid update through the store). -->
  <PropertyGroup>
    <UpdateFeed Condition="'$(UpdateFeed)' == ''">github:Neo-403/viewer</UpdateFeed>
  </PropertyGroup>

  <!-- Optional build expiry, set with -p:OpenIpcExpiry=... Empty (the default)
       means the build never expires. Accepted values: a number of days counted
       from build time (e.g. 365) or a UTC date (2027-11-09) that stays usable
       for the whole day. The raw value plus the build timestamp are stamped
       into every assembly; Core/BuildExpiration.cs resolves them at runtime.
       A time-limited build must not be able to replace itself, so its update
       feed is forced to none and the settings page hides the repo links. -->
  <PropertyGroup>
    <OpenIpcExpiry Condition="'$(OpenIpcExpiry)' == ''"></OpenIpcExpiry>
    <OpenIpcBuiltAt Condition="'$(OpenIpcExpiry)' != ''">$([System.DateTime]::UtcNow.ToString('o'))</OpenIpcBuiltAt>
    <UpdateFeed Condition="'$(OpenIpcExpiry)' != ''">none</UpdateFeed>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="OpenIpc.UpdateFeed" Value="$(UpdateFeed)" />
    <AssemblyMetadata Include="OpenIpc.Expiry" Value="$(OpenIpcExpiry)" />
    <AssemblyMetadata Include="OpenIpc.BuiltAt" Value="$(OpenIpcBuiltAt)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.1'">
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
