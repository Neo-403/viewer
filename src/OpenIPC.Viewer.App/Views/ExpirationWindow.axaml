<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:OpenIPC.Viewer.App.Views"
        x:Class="OpenIPC.Viewer.App.Views.ExpirationWindow"
        Title="OpenIPC Viewer"
        Icon="/Assets/openipc-logo.png"
        Width="440" Height="260"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg1Brush}">

  <!-- Setting MainWindow is enough: ClassicDesktopStyleApplicationLifetime
       shows it after setup. DataContext flows down to ExpirationView. -->
  <views:ExpirationView />
</Window>
